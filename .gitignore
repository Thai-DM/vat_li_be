# =============================================================================
# Gitignore - Hệ Thống Quản Lý Học Tập & Thí Nghiệm Ảo Vật Lý 1
# Chỉ giữ lại các tệp mã nguồn và cấu hình cần thiết để build & chạy dự án
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Tài Liệu Word, Markdown & Văn Bản (Không cần đẩy lên Git)
# -----------------------------------------------------------------------------
*.docx
*.doc
*.md
*.txt
*.pdf
*.xlsx
*.xls
*.pptx
*.ppt
~$*.docx
~$*.xlsx
~$*.pptx

# -----------------------------------------------------------------------------
# 2. Maven Build & Compiled Classes
# -----------------------------------------------------------------------------
target/
**/target/
build/
**/build/
dist/
**/dist/
out/
**/out/
*.class
*.jar
*.war
*.ear

# Bộ cài Maven cục bộ & các file nén dung lượng lớn
apache-maven-*/
**/apache-maven-*/
maven.zip
**/maven.zip
*.zip
*.tar.gz
*.rar

# Giữ lại Maven Wrapper để chạy được lệnh build (mvnw, mvnw.cmd)
!mvnw
!mvnw.cmd
!**/mvnw
!**/mvnw.cmd
!.mvn/wrapper/maven-wrapper.jar
!**/.mvn/wrapper/maven-wrapper.jar
!.mvn/wrapper/maven-wrapper.properties
!**/.mvn/wrapper/maven-wrapper.properties

# -----------------------------------------------------------------------------
# 3. Dữ Liệu Tải Lên & File Upload (Tránh đẩy file test 50MB+)
# -----------------------------------------------------------------------------
uploads/*
**/uploads/*
!uploads/.gitkeep
!**/uploads/.gitkeep

# -----------------------------------------------------------------------------
# 4. Bảo Mật & Biến Môi Trường (Secrets & Credentials)
# -----------------------------------------------------------------------------
.env
.env.local
.env.*.local
*.env
!*.env.example
!**/*.env.example
secrets/
*.pem
*.key
*.p12

# -----------------------------------------------------------------------------
# 5. Nhật Ký & Tệp Tạm Hệ Thống (Logs & Temp Files)
# -----------------------------------------------------------------------------
*.log
logs/
**/logs/
*.tmp
*.temp
*.bak
*.swp
*~

# -----------------------------------------------------------------------------
# 6. Cấu Hình IDE & Code Editor
# -----------------------------------------------------------------------------
# IntelliJ IDEA
.idea/
**/.idea/
*.iws
*.iml
*.ipr

# Eclipse / STS
.apt_generated/
.classpath
.factorypath
.project
.settings/
.springBeans

# Visual Studio Code
.vscode/
**/.vscode/

# NetBeans
nbproject/private/
nbbuild/
nbdist/
.nb-gradle/

# -----------------------------------------------------------------------------
# 7. Tệp Rác Hệ Điều Hành (OS specific)
# -----------------------------------------------------------------------------
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
.AppleDouble
.LSOverride
._*
