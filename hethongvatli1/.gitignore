# =============================================================================
# Gitignore - hethongvatli1 (Spring Boot Backend)
# Chỉ giữ lại các tệp mã nguồn và cấu hình cần thiết để build & chạy dự án
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Tài Liệu Word, Markdown & Văn Bản (Không cần đẩy lên Git)
# -----------------------------------------------------------------------------
*.docx
*.doc
*.md
!README.md
!**/README.md
!BACKEND_MASTER_CHANGELOG.md
!BACKEND_PERFORMANCE_REPORT.md
!EXAM_PROCTORING_FRONTEND_GUIDE.md
*.txt
*.pdf
*.xlsx
*.xls
*.pptx
*.ppt
~$*.docx
~$*.xlsx
~$*.pptx

# -----------------------------------------------------------------------------
# 2. Maven Build Output & Compiled Classes
# -----------------------------------------------------------------------------
target/
build/
dist/
out/
k6.exe
*.class
*.jar
*.war
*.ear
*.zip
*.tar.gz
*.rar

# Giữ lại Maven Wrapper để build & run
!mvnw
!mvnw.cmd
!.mvn/wrapper/maven-wrapper.jar
!.mvn/wrapper/maven-wrapper.properties

# -----------------------------------------------------------------------------
# 3. User Uploads (Tránh đẩy file test 50MB+)
# -----------------------------------------------------------------------------
uploads/*
!uploads/.gitkeep
storage/

# -----------------------------------------------------------------------------
# 4. Secrets & Credentials
# -----------------------------------------------------------------------------
.env
.env.local
.env.*.local
*.env
!*.env.example
secrets/
*.pem
*.key
*.p12
*local*.yml
*local*.yaml
*local*.properties
**/application-local.*

# -----------------------------------------------------------------------------
# 5. Logs & Temp Files
# -----------------------------------------------------------------------------
*.log
logs/
*.tmp
*.temp
*.bak
*.swp
*~

# -----------------------------------------------------------------------------
# 6. IDE Configurations
# -----------------------------------------------------------------------------
.idea/
*.iws
*.iml
*.ipr
.vscode/
.apt_generated/
.classpath
.factorypath
.project
.settings/
.springBeans
nbproject/private/
nbbuild/
nbdist/
.nb-gradle/

# -----------------------------------------------------------------------------
# 7. OS Specific Files
# -----------------------------------------------------------------------------
Thumbs.db
Desktop.ini
.DS_Store
.AppleDouble
.LSOverride
._*
