# Database Configuration (Neon Cloud PostgreSQL or Local Docker)
DATABASE_URL=jdbc:postgresql://localhost:5432/vatly1
DATABASE_USERNAME=vatly1
DATABASE_PASSWORD=change_me

# Security & JWT Configuration (Must be at least 32 characters in production)
JWT_SECRET=change_me_to_a_long_random_secret_key_at_least_32_chars
JWT_EXPIRE_MS=900000
JWT_REFRESH_EXPIRE_MS=604800000

# CORS Allowed Origins (Comma-separated list, e.g., http://localhost:3000)
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://yourfrontend.com

# File Upload Settings
FILE_UPLOAD_DIR=/app/uploads
FILE_MAX_SIZE_MB=50

# Server Port
SERVER_PORT=8080
